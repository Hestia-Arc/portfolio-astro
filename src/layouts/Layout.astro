---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import Head from "@/components/head.astro";
import Header from "@/components/header.astro";
import siteConfig from "@/config/site.json";

// Extend the Props interface to include all head options
interface Props {
	author?: string;
	canonical?: string;
	colorScheme?: "light" | "dark" | "light dark";
	description?: string;
	image?: string;
	keywords?: string;
	modifiedTime?: string;
	nofollow?: boolean;
	noindex?: boolean;
	ogLocale?: string;
	ogSiteName?: string;
	publishedTime?: string;
	robots?: string;
	section?: string;
	tags?: string[];
	themeColor?: string;
	title?: string;
	twitterCard?: "summary" | "summary_large_image" | "app" | "player";
	twitterCreator?: string;
	twitterSite?: string;
	type?: "website" | "article" | "profile";
	url?: string;
	viewport?: string;
}

const { ...props } = Astro.props;

const { company, contact } = siteConfig;
---

<!doctype html>
<html lang="en">
	<head>
		<Head {...props} />
		<ClientRouter />
	</head>
	<body
		class="flex h-screen w-full flex-col font-medium leading-snug tracking-tight antialiased"
	>
		<!-- Header -->
		<Header />

		<!-- Main content wrapper -->
		<main
			class="relative flex flex-1 flex-col px-30 h-screen w-full overflow-hidden"
		>
			<div class="absolute bottom-0 right-0 w-1/2 h-[280px] bg-[#fff]">
				<slot name="projects" />
			</div>

			<div class="flex flex-1 bg-[#ececec]">
				<!-- Left section -->
				<div class="flex flex-1 flex-col bg-blue-100 w-full">
					<slot name="left-content" />
				</div>
				<!-- Right section -->
				<div class="flex flex-1 flex-col gap-2 px-25 pt-25">
					<slot name="right-content" />
				</div>
			</div>
		</main>

		<!-- Mobile footer - positioned at bottom of page -->
		<!-- <footer
			class="lg:hidden w-full py-8 px-4 border-t border-gray-200 mt-auto"
		>
