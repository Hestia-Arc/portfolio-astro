---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import { BookOpen } from "@lucide/astro";
import Fade from "@/components/fade.astro";
import Head from "@/components/head.astro";
import siteConfig from "@/config/site.json";

// Extend the Props interface to include all head options
interface Props {
	author?: string;
	canonical?: string;
	colorScheme?: "light" | "dark" | "light dark";
	description?: string;
	image?: string;
	keywords?: string;
	modifiedTime?: string;
	nofollow?: boolean;
	noindex?: boolean;
	ogLocale?: string;
	ogSiteName?: string;
	publishedTime?: string;
	robots?: string;
	section?: string;
	tags?: string[];
	themeColor?: string;
	title?: string;
	twitterCard?: "summary" | "summary_large_image" | "app" | "player";
	twitterCreator?: string;
	twitterSite?: string;
	type?: "website" | "article" | "profile";
	url?: string;
	viewport?: string;
}

const { ...props } = Astro.props;

const { company, contact } = siteConfig;

// Define which social networks to show in footer (showing only those with actual URLs)
const footerSocials = [
	{ icon: BookOpen, name: "LinkedIn", url: contact.linkedin },
	{ icon: BookOpen, name: "GitHub", url: contact.github },
	{ icon: BookOpen, name: "Twitter", url: contact.twitter },
	{ icon: BookOpen, name: "Instagram", url: contact.instagram },
	{ icon: BookOpen, name: "Medium", url: contact.medium },
].filter(
	(social) =>
		social.url &&
		social.url !== "" &&
		social.url !== "#" &&
		!social.url.includes("placeholder") &&
		!social.url.includes("example.com"),
);
---

<!doctype html>
<html lang="en">
	<head>
		<Head {...props} />
		<ClientRouter />
	</head>
	<body
		class="flex h-screen w-full flex-col font-medium leading-snug tracking-tight antialiased"
	>
		<!-- Main content wrapper -->
		<main
			class="flex flex-1 flex-col px-30 h-screen w-full overflow-hidden"
		>
			<div class="h-[90px] flex items-center justify-between">
				<div>LOGO</div>

				<div class="flex items-center gap-4">
					<span>GITHUB</span>

					<span>LINKEDIN</span>

					<span>TWITTER</span>

					<span>INSTAGRAM</span>
				</div>
			</div>

			<div class="flex flex-1 bg-[#ececec]">
				<!-- Left section -->
				<div
					class="flex flex-1 flex-col bg-blue-100 w-full"
				>
					<slot name="left-content" />
				</div>
				<!-- Right section -->
				<div
					class="flex flex-1 flex-col gap-2 p-4 md:p-2 w-full relative min-w-0"
				>
					<slot name="right-content" />
				</div>
			</div>
		</main>

		<!-- Mobile footer - positioned at bottom of page -->
		<footer
			class="lg:hidden w-full py-8 px-4 border-t border-gray-200 mt-auto"
		>
			<div class="w-full flex flex-col gap-4">
				<!-- Social Links -->
				<div class="flex items-center gap-4 mb-4">
					{
						footerSocials.map((social) => {
							const IconComponent = social.icon;
							return (
								<a
									href={social.url}
									target="_blank"
									rel="noopener noreferrer"
									class="text-foreground/70 hover:text-foreground transition-colors"
									aria-label={`Visit ${social.name}`}
								>
									<IconComponent class="w-5 h-5" />
								</a>
							);
						})
					}
				</div>
				<p class="text-xs text-foreground/70">{company.footerText}</p>
				<p class="text-xs text-foreground/70">{company.copyright}</p>
			</div>
		</footer>
	</body>
</html>
