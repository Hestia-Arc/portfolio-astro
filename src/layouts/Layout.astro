---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import Head from "@/components/head.astro";
// import Header from "@/components/header.astro";
// import siteConfig from "@/config/site.json";
import { PortfolioShell } from "@/layouts/PortfolioLayout.tsx";

// Extend the Props interface to include all head options
interface Props {
	author?: string;
	canonical?: string;
	colorScheme?: "light" | "dark" | "light dark";
	description?: string;
	image?: string;
	keywords?: string;
	modifiedTime?: string;
	nofollow?: boolean;
	noindex?: boolean;
	ogLocale?: string;
	ogSiteName?: string;
	publishedTime?: string;
	robots?: string;
	section?: string;
	tags?: string[];
	themeColor?: string;
	title?: string;
	twitterCard?: "summary" | "summary_large_image" | "app" | "player";
	twitterCreator?: string;
	twitterSite?: string;
	type?: "website" | "article" | "profile";
	url?: string;
	viewport?: string;
}

const { ...props } = Astro.props;

// const { company, contact } = siteConfig;
---

<!doctype html>
<html lang="en">
	<head>
		<Head {...props} />
		<ClientRouter />
	</head>
	<body
		class="flex h-screen w-full flex-col font-medium leading-snug tracking-tight antialiased"
	>
		<PortfolioShell client:load />
	</body>
</html>
